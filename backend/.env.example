# GreenGen Backend Environment Configuration
# Copy this file to .env and fill in values as needed. Never commit real API keys!

# SQLite Database Path (defaults to ./greengen.db or /tmp/greengen.db)
GREENGEN_DB_PATH=./greengen.db

# Optional External LLM API Key for RAG Sustainability Assistant
# When omitted, GreenGen automatically operates in Grounded Deterministic RAG Fallback Mode
# using verified knowledge base vector retrieval + exact dataset analytics.
OPENAI_API_KEY=
GREENGEN_LLM_API_KEY=
GREENGEN_LLM_MODEL=gpt-4o-mini

# Backend Server Port
PORT=8000
